# Strategy Parameters (override defaults)
RSI_PERIOD=14              # Standard RSI period
EMA_SHORT_PERIOD=9         # Fast moving average
EMA_LONG_PERIOD=21         # Slow moving average
BB_PERIOD=20               # Bollinger Bands period
VOLUME_PERIOD=20           # Volume MA period

# Trading Parameters
MIN_CONFIDENCE=0.60        # Only trade signals with >60% confidence
POSITION_SIZE=0.01         # Default 0.01 BTC per trade
MAX_POSITIONS=3            # Max concurrent positions
